---
import '../styles/marker.css';
import { Image } from 'astro:assets';
import Site from '../layouts/Site.astro';
import Shell from '../components/Shell.astro';
import Icon from '../components/Icon.astro';
import photo from '../assets/mithusha.jpg';
import seo from '../seo.json';
import * as c from '../content';

// The visible FAQ is the FAQPage schema carried over from the old site, so the two always match.
const graph = seo.home.jsonld.flatMap((j: any) => j['@graph'] ?? [j]);
const faq = (graph.find((n: any) => n['@type'] === 'FAQPage')?.mainEntity ?? []).map((q: any) => [q.name, q.acceptedAnswer.text]);
const notes = ['#ffe36b', '#ffb3c7', '#9fe6d6', '#ffe36b', '#c9b8ff', '#ffc98a'];
const tilts = [-2, 1.5, -1, 2, -1.5, 1];
const pens = ['#1d4ed8', '#c81e3a', '#0f7a4a', '#1d4ed8', '#c81e3a', '#0f7a4a'];
---
<Site page="home">
<Shell home>
  <section class="board hero">
    <div>
      <h1>English, Maths &amp; 11+ tutor in <span class="swipe">Stanmore &amp; Harrow</span></h1>
      <p class="lede">{c.intro}</p>
      <div class="actions">
        <a class="btn btn-call" href={c.tel}><Icon name="phone" />Call {c.phone}</a>
        <a class="btn btn-wa" href={c.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp me</a>
      </div>
      <a class="nd" href="#parents"><Icon name="heart" size={18} /><span><strong>{c.nextdoorStats.faves}</strong> faves and <strong>{c.nextdoorStats.recommendations}</strong> parent recommendations on Nextdoor</span></a>
    </div>
    <div class="board-photo">
      <svg class="doodle doodle-arrow" viewBox="0 0 220 120" aria-hidden="true"><path d="M8 98 C 50 30, 120 20, 190 52" /><path d="M170 34 L 193 53 L 166 66" /></svg>
      <span class="note-label" aria-hidden="true">your teacher!</span>
      <div class="taped"><span class="tape" aria-hidden="true"></span><span class="tape" aria-hidden="true"></span><Image src={photo} alt="Mithusha, qualified teacher and private tutor in Stanmore" width={440} height={474} loading="eager" fetchpriority="high" /></div>
      <ul class="ticks">{c.credentials.slice(0, 3).map((x) => <li><Icon name="check" size={22} />{x.title}</li>)}</ul>
    </div>
  </section>

  <section class="sheet" id="teach" aria-labelledby="teach-h">
    <h2 id="teach-h">What I teach, <span class="inked">youngest first</span></h2>
    <ol class="steps">
      {c.stages.map((s, i) => (
        <li style={`--pen:${pens[i]}`}>
          <a href={c.u(s.href)}><span class="what">{s.label}</span><span class="ages">{s.ages}</span><span class="why">{s.text}</span></a>
        </li>
      ))}
    </ol>
  </section>

  <section class="sheet" id="parents" aria-labelledby="parents-h">
    <h2 id="parents-h">Notes from parents <span class="nowrap" style="font-size:max(1rem,.5em);color:var(--mk-ink-2)">(on Nextdoor)</span></h2>
    <figure class="big-note">
      <blockquote>“{c.featured.text}”</blockquote>
      <figcaption>{c.featured.name} · {c.featured.area} · {c.featured.tag}</figcaption>
    </figure>
    <ul class="notes">
      {c.reviews.map((r, i) => (
        <li style={`--note:${notes[i]}; --tilt:${tilts[i]}deg`}>{i % 2 === 0 && <span class="tape" aria-hidden="true"></span>}<p>“{r.text}”</p><p class="who">{r.name} · {r.area}</p></li>
      ))}
    </ul>
    <a class="more" href={c.nextdoor} target="_blank" rel="noopener">Read them all on Nextdoor <Icon name="arrow" size={18} /></a>
  </section>

  <section class="sheet" id="fees" aria-labelledby="fees-h">
    <h2 id="fees-h">Fees, <span class="inked" style="--pen:var(--mk-blue)">worked out</span></h2>
    <ul class="sum-list">
      {c.fees.map((f) => <li><span class="lhs">1 hour {f.where.replace(/^At/, 'at').replace(/^Online/, 'online')}</span><span class="eq">=</span><span class="rhs">{f.price}</span><span class="sum-note">{f.note}</span></li>)}
    </ul>
    <p class="hours">{c.hours}</p>
  </section>

  <section class="sheet" id="about" aria-labelledby="about-h">
    <h2 id="about-h">About me</h2>
    <div class="about-grid">
      <div>
        {c.about.map((p) => <p>{p}</p>)}
        <ul class="ticked creds">{c.credentials.map((x) => <li><Icon name="check" size={20} />{x.title}, <span style="font-family:Lexend,sans-serif;font-weight:400;font-size:.95rem;color:var(--mk-ink-2)">{x.detail}</span></li>)}</ul>
      </div>
      <div>
        <p class="ticked-h">Home visits all over Harrow</p>
        <ul class="ticked">{c.areas.map((a) => <li><Icon name="check" size={18} />{a}</li>)}</ul>
        <p style="margin-top:1rem">Online lessons anywhere in the UK. <a href={c.u('home-tutor-harrow/')}>More about home tuition in Harrow</a>.</p>
      </div>
    </div>
  </section>

  <section class="sheet faq" id="faq" aria-labelledby="faq-h">
    <svg class="doodle qmark" viewBox="0 0 100 140" aria-hidden="true"><path d="M22 40 C 20 12, 78 4, 80 36 C 82 60, 50 62, 50 88" stroke-width="7" /><path d="M49 112 C 51 114, 52 118, 49 120" stroke-width="9" /></svg>
    <h2 id="faq-h">Questions parents ask</h2>
    {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
  </section>

  <section class="board close">
    <h2>Let's have a <span class="swipe">quick chat</span></h2>
    <p>No obligation. Tell me about your child and I'll suggest a plan.</p>
    <div class="actions">
      <a class="btn btn-call" href={c.tel}><Icon name="phone" />Call {c.phone}</a>
      <a class="btn btn-wa" href={c.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp me</a>
    </div>
  </section>
</Shell>
</Site>

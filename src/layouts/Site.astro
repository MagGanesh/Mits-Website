---
// Production layout for the live site.
// This is the real site: indexable, and its title,
// description, canonical, Open Graph and JSON-LD are carried over verbatim
// from the previous hand-written site (src/seo.json) so rankings are kept.
// Absolute URLs in seo.json are written {SITE}... and filled from PUBLIC_SITE_URL.
import seo from '../seo.json';
import { abs, publicUrl } from '../site';

interface Props { page: keyof typeof seo }
const { page } = Astro.props;
const s = seo[page];
const decode = (v: string) => v.replace(/&amp;/g, '&').replace(/&quot;/g, '"').replace(/&#39;/g, "'");
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const og = `${publicUrl}assets/mithusha-tutor-stanmore.jpg`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{decode(s.title)}</title>
    <meta name="description" content={decode(s.desc)} />
    <link rel="canonical" href={abs(s.canonical)} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#fbfcfd" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-192.png`} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Future Foundations Tutoring" />
    <meta property="og:title" content={decode(s.ogTitle ?? s.title)} />
    <meta property="og:description" content={decode(s.ogDesc ?? s.desc)} />
    <meta property="og:url" content={abs(s.canonical)} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    {s.jsonld.map((j) => <script type="application/ld+json" set:html={abs(JSON.stringify(j))} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
